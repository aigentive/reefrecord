{
  "name": "reef-recorder-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Reef Recorder — desktop recorder and Gemini transcription",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "frontend:install": "cd frontend && npm install",
    "tauri:dev": "./frontend/node_modules/.bin/tauri dev",
    "tauri:build": "./frontend/node_modules/.bin/tauri build",
    "typecheck": "cd frontend && npm run typecheck",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:gemini": "cd src-tauri && cargo test gemini::transcription::tests::real_gemini_transcribes_silent_wav_with_existing_key -- --ignored --exact"
  }
}
